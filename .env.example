# ============================================================
# SweetLens Frontend — biến môi trường
#   Copy file này thành .env (bị gitignore — KHÔNG commit).
# ============================================================

# URL Backend Laravel — BẮT BUỘC kết thúc bằng /api
#   Dev local : http://localhost:8000/api   (BE chạy php artisan serve)
#   Production: https://dslr-api.onrender.com/api   (Render)
#
# Gọi TRỰC TIẾP backend (không qua Vercel rewrites/proxy):
#   upload ảnh + GIF base64 trong 1 request có thể vượt 4.5MB —
#   vượt giới hạn body của Vercel → ảnh sẽ không upload được.
# Khi gọi trực tiếp cross-site, Render phải đặt:
#   CORS_ORIGINS=https://<fe>.vercel.app,http://localhost:5173
#   JWT_COOKIE_SAMESITE=None   (xem README)
VITE_API_BASE_URL=http://localhost:8000/api

# Bridge local (serverr) — máy ảnh digiCamControl, máy in SELPHY, máy đếm tiền
#   Máy admin chạy trên Vercel không thấy localhost → thay bằng URL ngrok
#   public của bridge (vd: https://xxxx.ngrok-free.dev)
VITE_AI_API_URL=http://localhost:5000

# Bridge cho kiosk (bỏ trống sẽ fallback = VITE_AI_API_URL)
#   Kiosk đặt http://localhost:5000
VITE_BRIDGE_URL=http://localhost:5000
